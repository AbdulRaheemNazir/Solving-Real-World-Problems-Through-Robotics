{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *  # Import VEX robotics library\nimport urandom     # Import urandom for random number generation (based on entropy)\n\n# Initialize the Brain object\nbrain = Brain()\n\n# Set up robot's inertial sensor and two motors\nbrain_inertial = Inertial()\nmotor1 = Motor(Ports.PORT1, True)  # Motor on port 1, reversed direction\nmotor2 = Motor(Ports.PORT2, True)  # Motor on port 2, reversed direction\n\n# Initialize bumper sensors for start and stop\nbumper_start = Bumper(brain.three_wire_port.b)  # Start button on port b\nbumper_stop = Bumper(brain.three_wire_port.c)   # Stop button on port c\n\n# Give time for sensors to fully initialize\nwait(100, MSEC)\n\n# Function to initialize a random seed for unpredictable combos\ndef initializeRandomSeed():\n    wait(100, MSEC)  # Wait a bit before getting sensor data\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000  # Read X-axis acceleration\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000  # Read Y-axis acceleration\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000  # Read Z-axis acceleration\n    systemTime = brain.timer.system() * 100            # Get system time\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime))  # Use the values to seed RNG\n\n# Call the random seed initializer\ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n\n#region VEXcode Generated Robot Configuration (again, possibly due to copy-paste redundancy)\nfrom vex import *  # VEX library import (duplicate but harmless)\nimport urandom     # urandom import (again)\nimport random      # Standard random module for combo selection\n\n# Initialize brain and robot components\nbrain = Brain()\nbrain_inertial = Inertial()\nmotor1 = Motor(Ports.PORT1, True)   # Motor 1, reversed\nmotor2 = Motor(Ports.PORT2, False)  # Motor 2, normal direction\n\n# Setup bumpers for start and stop\nbumper_start = Bumper(brain.three_wire_port.b)\nbumper_stop = Bumper(brain.three_wire_port.c)\n\n# Allow some setup time\nwait(100, MSEC)\n\n# Set motor speed to 50% for both motors\nmotor1.set_velocity(50, PERCENT)\nmotor2.set_velocity(50, PERCENT)\n\n# Position values for head and body strikes\nposition_map = {\n    \"head\": 0,      # 0 degrees position for head\n    \"body\": 4320    # 4320 degrees position for body (12 full revolutions)\n}\n\n# Define all possible punching combinations using jab and cross\npunching_combos = [\n    {\"combo\": \"JH CH\", \"m1\": \"head\", \"m2\": \"head\"},\n    {\"combo\": \"CH JH\", \"m1\": \"head\", \"m2\": \"head\"},\n    {\"combo\": \"JH CB\", \"m1\": \"head\", \"m2\": \"body\"},\n    {\"combo\": \"CB JH\", \"m1\": \"body\", \"m2\": \"head\"},\n    {\"combo\": \"JB CH\", \"m1\": \"body\", \"m2\": \"head\"},\n    {\"combo\": \"CH JB\", \"m1\": \"head\", \"m2\": \"body\"},\n    {\"combo\": \"JB CB\", \"m1\": \"body\", \"m2\": \"body\"},\n    {\"combo\": \"CB JB\", \"m1\": \"body\", \"m2\": \"body\"}\n]\n\n# Define all possible kicking combinations\nkicking_combos = [\n    {\"combo\": \"HEAD HEAD\", \"m1\": \"head\", \"m2\": \"head\"},\n    {\"combo\": \"HEAD BODY\", \"m1\": \"head\", \"m2\": \"body\"},\n    {\"combo\": \"BODY HEAD\", \"m1\": \"body\", \"m2\": \"head\"},\n    {\"combo\": \"BODY BODY\", \"m1\": \"body\", \"m2\": \"body\"}\n]\n\n# Set total match duration to 120 seconds (2 minutes)\ntotal_match_seconds = 120\n\n# Countdown function that displays time and handles stop trigger\ndef countdown_and_update_time(start_seconds, time_left):\n    for i in range(start_seconds, 0, -1):  # Countdown from start_seconds to 1\n        minutes = time_left // 60  # Calculate remaining minutes\n        seconds = time_left % 60   # Calculate remaining seconds\n\n        # Display countdown and match time on screen\n        brain.screen.set_cursor(3, 1)\n        brain.screen.print(\"Start: %d\" % i)\n\n        brain.screen.set_cursor(4, 1)\n        brain.screen.print(\"Min: %d\" % minutes)\n\n        brain.screen.set_cursor(5, 1)\n        brain.screen.print(\"Sec: %02d\" % seconds)\n\n        wait(1, SECONDS)  # Wait one second\n        time_left -= 1    # Decrease match time by one second\n\n        # Clear the rows to update cleanly\n        brain.screen.clear_row(3)\n        brain.screen.clear_row(4)\n        brain.screen.clear_row(5)\n\n        # Stop the match early if stop bumper is pressed\n        if bumper_stop.pressing():\n            return False, time_left\n\n    return True, time_left  # Continue match\n\n# --------- KICKING MODE FUNCTION ---------\ndef kicking_mode():\n    brain.screen.clear_screen()  # Clear screen at start\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(\"Starting...\")\n    wait(500, MSEC)  # Wait half a second\n\n    # Ensure motors spin in correct direction\n    motor1.set_reversed(True)\n    motor2.set_reversed(True)\n\n    time_left = total_match_seconds  # Initialize match time\n\n    while time_left > 0:  # Loop while time remains\n        if bumper_stop.pressing():  # Stop early if bumper is pressed\n            brain.screen.clear_screen()\n            brain.screen.set_cursor(1, 1)\n            brain.screen.print(\"Stopped\")\n            return\n\n        selected = random.choice(kicking_combos)  # Pick a random kick combo\n        t1, t2 = selected[\"m1\"], selected[\"m2\"]\n        pos1, pos2 = position_map[t1], position_map[t2]  # Get motor positions\n\n        # Stop both motors before next move\n        motor1.stop()\n        motor2.stop()\n        wait(100, MSEC)\n\n        # Display kick type and combo\n        brain.screen.clear_screen()\n        brain.screen.set_cursor(1, 1)\n        brain.screen.print(\"KICK\")\n        brain.screen.set_cursor(2, 1)\n        brain.screen.print(selected[\"combo\"])\n\n        # Run countdown before executing kicks\n        proceed, time_left = countdown_and_update_time(3, time_left)\n        if not proceed:\n            return\n\n        # Execute motor movement to kick positions\n        motor1.spin_to_position(pos1, DEGREES, wait=True)\n        motor2.spin_to_position(pos2, DEGREES, wait=True)\n        wait(1, SECONDS)\n\n    # End of match message\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(\"MATCH OVER\")\n    wait(3, SECONDS)\n\n# --------- PUNCHING MODE FUNCTION ---------\ndef punching_mode():\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(\"Starting...\")\n    wait(500, MSEC)\n\n    # Set motors to proper direction\n    motor1.set_reversed(True)\n    motor2.set_reversed(True)\n\n    time_left = total_match_seconds\n\n    while time_left > 0:\n        if bumper_stop.pressing():\n            brain.screen.clear_screen()\n            brain.screen.set_cursor(1, 1)\n            brain.screen.print(\"Stopped\")\n            return\n\n        selected = random.choice(punching_combos)  # Randomly select punch combo\n        t1, t2 = selected[\"m1\"], selected[\"m2\"]\n        pos1, pos2 = position_map[t1], position_map[t2]\n\n        motor1.stop()\n        motor2.stop()\n        wait(100, MSEC)\n\n        brain.screen.clear_screen()\n        brain.screen.set_cursor(1, 1)\n        brain.screen.print(\"PUNCH\")\n        brain.screen.set_cursor(2, 1)\n        brain.screen.print(selected[\"combo\"])\n\n        proceed, time_left = countdown_and_update_time(3, time_left)\n        if not proceed:\n            return\n\n        # Execute punch movements\n        motor1.spin_to_position(pos1, DEGREES, wait=False)\n        motor2.spin_to_position(pos2, DEGREES, wait=True)\n        wait(1, SECONDS)\n\n    # Display match end\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(\"MATCH OVER\")\n    wait(3, SECONDS)\n\n# --------- MAIN LOOP ---------\nwhile True:\n    # Wait until start bumper is released\n    while bumper_start.pressing():\n        wait(50, MSEC)\n\n    # Prompt user to press bumper to start match\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"Press B to START\")\n\n    # Wait until bumper is pressed to start match\n    while not bumper_start.pressing():\n        wait(50, MSEC)\n\n    # Clear screen and reset motor positions\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(2, 1)\n    motor1.set_position(0, DEGREES)\n    motor2.set_position(0, DEGREES)\n\n    # Wait for bumper release before proceeding\n    while bumper_start.pressing():\n        wait(20, MSEC)\n    wait(500, MSEC)  # Extra wait to debounce\n\n    kicking_mode()  # Run kicking mode\n    #punching_mode()  # Uncomment to use punching mode instead\n","textLanguage":"python","robotConfig":[{"port":[1],"name":"motor1","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[2],"name":"motor2","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[2],"name":"bumper_start","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[3],"name":"bumper_stop","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22}],"slot":0,"platform":"EXP","sdkVersion":"20240802.15.00.00","appVersion":"4.0.8","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false}